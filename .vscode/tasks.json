{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build (debug)",
            "type": "shell",
            "command": "clang++",
            "args": ["-std=c++17", "-g", "-O0", "-Wall", "${file}", "-o", "${fileDirname}/${fileBasenameNoExtension}.out"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        }
    ]
}
